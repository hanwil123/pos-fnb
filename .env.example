# Application Settings
APP_NAME=POS Backend
APP_PORT=8080
APP_ENV=development
LOG_LEVEL=debug

# Database Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=pos_fnb
DB_SSLMODE=disable
DB_AUTO_MIGRATE=true
DB_SEED=false

# JWT Settings
JWT_SECRET=ganti-dengan-secret-yang-kuat-di-production
ACCESS_TOKEN_EXPIRED=120
REFRESH_TOKEN_EXPIRED=240

# QR Code Security
QR_HMAC_SECRET=ganti-dengan-secret-lain-yang-kuat

# Redis Settings
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# SMTP Settings (Optional - untuk fitur email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@posfnb.app

# Storage Settings
STORAGE_PATH=uploads
